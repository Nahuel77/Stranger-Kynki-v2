---

---

<div class="hero">
  <div class="content">
    <h1 class="title">Stranger<br />Kynki</h1>
    <h2 class="subtitle">EVENTS, EXPERIENCES, MEMORIES</h2>
    <div class="description">
      <p>
        We design unique experiences that transcend the ordinary. Events that
        are felt, lived, and remembered.
      </p>
      <button>discover more</button>
    </div>
  </div>
</div>

<style>
  .hero {
    height: 100vh;
    background-image: url("../../public/images/herobg.png");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: right center;
    background-color: black;
  }
  .content {
    display: flex;
    flex-direction: column;
    width: 50%;
    height: 100%;
    justify-content: center;
    align-items: center;
    margin-left: 3rem;
    text-align: center;
  }
  .title {
    font-size: 7rem;
    text-transform: uppercase;
  }
  .subtitle {
    letter-spacing: 0.2em;
    margin: 1rem;
  }
  .description {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 80%;
  }
  .description p {
    text-align: start;
    letter-spacing: 0.2em;
    width: 18rem;
    margin: 1rem 0;
  }
  @media (max-width: 768px) {
    .hero {
      margin: 0;
      width: 100%;
    }
    .content {
      width: 100%;
      height: 90%;
      padding: 3rem 0;
      margin-left: 0;
      justify-content: space-around;
      align-items: center;
    }
    .title {
      font-size: 4rem;
    }
  }
</style>
