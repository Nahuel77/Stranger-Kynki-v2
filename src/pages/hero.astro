<div class="hero">
  <div class="content">
    <h1 class="title">Stranger<br />Kynki</h1>
    <h2 class="subtitle">EVENTS, EXPERIENCES, MEMORIES</h2>
    <div class="description">
      <p>
        We design unique experiences that transcend the ordinary. Events that
        are felt, lived, and remembered.
      </p>
      <a
        class="whatsapp-btn"
        href="https://wa.me/551151044382?text=Hello%20Stranger%20Kynki%2C%20I%20want%20to%20know%20more%20about%20your%20events."
        target="_blank"
      >
        <img class="knowmoreimg" src="/images/whatsapp.png" alt="whatsapp" />
        discover more
      </a>
    </div>
  </div>
</div>

<style>
  .hero {
    height: 90vh;
    background-image: url("../../public/images/herobg.png");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: right center;
    background-color: black;
  }
  .content {
    display: flex;
    flex-direction: column;
    width: 50%;
    height: 100%;
    justify-content: center;
    align-items: center;
    margin-left: 3rem;
    text-align: center;
  }
  .title {
    font-size: 7rem;
    text-transform: uppercase;
  }
  .subtitle {
    letter-spacing: 0.2em;
    margin: 1rem;
  }
  .description {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 80%;
  }
  .description a {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid #870900;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    transition: 0.5s;
    color: white;
    text-transform: uppercase;
  }
  .description a:hover {
    border: 1px solid white;
    transition: 0.5s;
  }
  .description p {
    text-align: start;
    letter-spacing: 0.2em;
    width: 18rem;
    margin: 1rem 0;
  }
  .knowmoreimg {
    width: 1rem;
    padding-right: 0.5rem;
  }
  @media (max-width: 768px) {
    .hero {
      margin: 0;
      width: 100%;
    }
    .content {
      width: 100%;
      height: 90%;
      padding: 0;
      margin-left: 0;
      justify-content: space-evenly;
      align-items: center;
    }
    .title {
      font-size: 4rem;
    }
  }
</style>
